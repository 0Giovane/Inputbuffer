`timescale 1ns/1ps

module tb_input_buffer;

parameter CLK_PERIOD   = 10;
parameter DEPTH        = 16384;
parameter ADDR_BITS    = 14;
parameter DATA_BITS    = 64;
parameter REPEAT_COUNT = 2;

reg clk;
reg rst_n;
reg prepare;
reg go;

wire [DATA_BITS-1:0] out_data;
wire out_valid;
wire ready_to_stream;
wire done;

wire [ADDR_BITS-1:0] rom_addr;
wire [DATA_BITS-1:0] rom_q;
wire rom_clock;

reg [DATA_BITS-1:0] ref_mem [0:DEPTH-1];

integer k;
integer file_out;
integer pass_count;
integer fail_count;
integer total_errors;
integer cycle_counter;

Input_Buffer #(
    .DEPTH(DEPTH),
    .ADDR_BITS(ADDR_BITS),
    .DATA_BITS(DATA_BITS),
    .REPEAT_COUNT(REPEAT_COUNT)
) dut (
    .clk(clk),
    .rst_n(rst_n),
    .prepare(prepare),
    .go(go),

    .rom_q(rom_q),
    .rom_addr(rom_addr),
    .rom_clock(rom_clock),

    .out_data(out_data),
    .out_valid(out_valid),
    .ready_to_stream(ready_to_stream),
    .done(done)
);

Memoria rom_inst (
    .clock(rom_clock),
    .address(rom_addr),
    .q(rom_q)
);

initial clk = 0;
always #(CLK_PERIOD/2) clk = ~clk;

always @(posedge clk) begin
    cycle_counter = cycle_counter + 1;
end

initial begin
    for (k = 0; k < DEPTH; k = k + 1)
        ref_mem[k] = 64'h0000000000000000;

    ref_mem[0]  = 64'hABCDEF0123456789;
    ref_mem[1]  = 64'h0123456789ABCDEF;
    ref_mem[2]  = 64'hFEDCBA9876543210;
    ref_mem[3]  = 64'h1122334455667788;
    ref_mem[4]  = 64'h8877665544332211;
    ref_mem[5]  = 64'hAABBCCDDEEFF0011;
    ref_mem[6]  = 64'h1100FFEEDDCCBBAA;
    ref_mem[7]  = 64'hDEADBEEFCAFEBABE;
    ref_mem[8]  = 64'hCAFEBABDEADBEEF0;
    ref_mem[9]  = 64'h0F0F0F0F0F0F0F0F;
    ref_mem[10] = 64'hF0F0F0F0F0F0F0F0;
    ref_mem[11] = 64'hAAAAAAAAAAAAAAAA;
    ref_mem[12] = 64'h5555555555555555;
    ref_mem[13] = 64'hFFFFFFFFFFFFFFFF;
    ref_mem[14] = 64'h0000000000000001;
    ref_mem[15] = 64'h8000000000000000;
end

task mark_pass;
    input integer tc;
begin
    $display("[TC%0d] PASS", tc);
    $fwrite(file_out, "[TC%0d] PASS\n", tc);
    pass_count = pass_count + 1;
end
endtask

task mark_fail;
    input integer tc;
    input [255:0] msg;
begin
    $display("[TC%0d] FAIL - %0s", tc, msg);
    $fwrite(file_out, "[TC%0d] FAIL - %0s\n", tc, msg);
    fail_count = fail_count + 1;
    total_errors = total_errors + 1;
end
endtask

task do_reset;
begin
    rst_n = 0;
    prepare = 0;
    go = 0;
    cycle_counter = 0;

    repeat (5) @(posedge clk);
    #1 rst_n = 1;

    repeat (3) @(posedge clk);
    #1;
end
endtask

task pulse_prepare;
begin
    @(posedge clk); #1;
    prepare = 1;
    @(posedge clk); #1;
    prepare = 0;
end
endtask

task pulse_go;
begin
    @(posedge clk); #1;
    go = 1;
    @(posedge clk); #1;
    go = 0;
end
endtask

task wait_ready;
    input integer tc;
    output integer ok;
    integer timeout;
begin
    ok = 0;
    timeout = 0;

    while (!ready_to_stream && timeout < 100) begin
        @(posedge clk); #1;
        timeout = timeout + 1;
    end

    if (ready_to_stream) begin
        ok = 1;
        $display("[TC%0d] ready_to_stream ativo no ciclo %0d", tc, cycle_counter);
        $fwrite(file_out, "[TC%0d] ready_to_stream ativo no ciclo %0d\n", tc, cycle_counter);
    end else begin
        mark_fail(tc, "timeout aguardando ready_to_stream");
    end
end
endtask

task tc1_prepare_sem_go;
    integer i;
    integer ok;
    integer errors;
begin
    errors = 0;

    $display("\nTC1 - prepare sem go");
    $fwrite(file_out, "\nTC1 - prepare sem go\n");

    do_reset();
    pulse_prepare();
    wait_ready(1, ok);

    if (!ok)
        errors = errors + 1;

    for (i = 0; i < 10; i = i + 1) begin
        @(posedge clk); #1;

        if (out_valid) begin
            errors = errors + 1;
            $display("[TC1] ERRO: out_valid ativou antes do go");
            $fwrite(file_out, "[TC1] ERRO: out_valid ativou antes do go\n");
        end

        if (done) begin
            errors = errors + 1;
            $display("[TC1] ERRO: done ativou antes do go");
            $fwrite(file_out, "[TC1] ERRO: done ativou antes do go\n");
        end
    end

    if (ready_to_stream && !out_valid && !done && errors == 0)
        mark_pass(1);
    else
        mark_fail(1, "prepare sem go nao ficou em READY corretamente");
end
endtask

task tc2_go_sem_prepare;
    integer i;
    integer errors;
begin
    errors = 0;

    $display("\nTC2 - go sem prepare");
    $fwrite(file_out, "\nTC2 - go sem prepare\n");

    do_reset();
    pulse_go();

    for (i = 0; i < 10; i = i + 1) begin
        @(posedge clk); #1;

        if (out_valid) begin
            errors = errors + 1;
            $display("[TC2] ERRO: out_valid ativou sem prepare");
            $fwrite(file_out, "[TC2] ERRO: out_valid ativou sem prepare\n");
        end

        if (ready_to_stream) begin
            errors = errors + 1;
            $display("[TC2] ERRO: ready_to_stream ativou sem prepare");
            $fwrite(file_out, "[TC2] ERRO: ready_to_stream ativou sem prepare\n");
        end

        if (done) begin
            errors = errors + 1;
            $display("[TC2] ERRO: done ativou sem prepare");
            $fwrite(file_out, "[TC2] ERRO: done ativou sem prepare\n");
        end
    end

    if (errors == 0)
        mark_pass(2);
    else
        mark_fail(2, "go sem prepare iniciou sinais indevidamente");
end
endtask

task tc3_stream_completo;
    integer expected_total;
    integer received_total;
    integer expected_addr;
    integer expected_repeat;
    integer timeout;
    integer local_errors;
    integer ok;
    integer start_cycle;
    integer finish_cycle;
    reg [DATA_BITS-1:0] expected;
begin
    expected_total  = DEPTH * REPEAT_COUNT;
    received_total  = 0;
    expected_addr   = 0;
    expected_repeat = 0;
    timeout         = 0;
    local_errors    = 0;

    $display("\nTC3 - prepare -> ready -> go -> stream completo");
    $fwrite(file_out, "\nTC3 - prepare -> ready -> go -> stream completo\n");

    do_reset();
    pulse_prepare();
    wait_ready(3, ok);

    if (!ok)
        local_errors = local_errors + 1;

    repeat (5) @(posedge clk);

    if (out_valid) begin
        local_errors = local_errors + 1;
        $display("[TC3] ERRO: out_valid antes do go");
        $fwrite(file_out, "[TC3] ERRO: out_valid antes do go\n");
    end

    pulse_go();
    start_cycle = cycle_counter;

    while (!done && timeout < (expected_total + 1000)) begin
        @(negedge clk);

        if (out_valid) begin
            expected = ref_mem[expected_addr];

            if (out_data !== expected) begin
                local_errors = local_errors + 1;
                $display("[TC3] FAIL rep=%0d addr=%0d data=%h esperado=%h",
                         expected_repeat, expected_addr, out_data, expected);
                $fwrite(file_out, "[TC3] FAIL rep=%0d addr=%0d data=%h esperado=%h\n",
                        expected_repeat, expected_addr, out_data, expected);
            end

            if (received_total < 20) begin
                $display("[TC3] PASS ciclo=%0d rep=%0d addr=%0d data=%h",
                         cycle_counter, expected_repeat, expected_addr, out_data);
            end

            received_total = received_total + 1;

            if (expected_addr == DEPTH - 1) begin
                expected_addr = 0;
                expected_repeat = expected_repeat + 1;
            end else begin
                expected_addr = expected_addr + 1;
            end
        end

        @(posedge clk); #1;
        timeout = timeout + 1;
    end

    finish_cycle = cycle_counter;

    if (received_total != expected_total) begin
        local_errors = local_errors + 1;
        $display("[TC3] ERRO total recebido=%0d esperado=%0d", received_total, expected_total);
        $fwrite(file_out, "[TC3] ERRO total recebido=%0d esperado=%0d\n", received_total, expected_total);
    end

    if (!done) begin
        local_errors = local_errors + 1;
        $display("[TC3] ERRO done nao ativou");
        $fwrite(file_out, "[TC3] ERRO done nao ativou\n");
    end

    $display("[TC3] CICLOS total=%0d transfers=%0d",
             finish_cycle - start_cycle, received_total);
    $fwrite(file_out, "[TC3] CICLOS total=%0d transfers=%0d\n",
            finish_cycle - start_cycle, received_total);

    if (local_errors == 0)
        mark_pass(3);
    else
        mark_fail(3, "stream completo apresentou erro");
end
endtask

task tc4_volta_addr_zero;
    integer expected_total;
    integer received_total;
    integer expected_addr;
    integer wraps;
    integer timeout;
    integer ok;
    integer errors;
begin
    expected_total = DEPTH * REPEAT_COUNT;
    received_total = 0;
    expected_addr = 0;
    wraps = 0;
    timeout = 0;
    errors = 0;

    $display("\nTC4 - verifica volta para endereco zero");
    $fwrite(file_out, "\nTC4 - verifica volta para endereco zero\n");

    do_reset();
    pulse_prepare();
    wait_ready(4, ok);
    pulse_go();

    while (!done && timeout < (expected_total + 1000)) begin
        @(negedge clk);

        if (out_valid) begin
            if (expected_addr == DEPTH - 1) begin
                wraps = wraps + 1;
                $display("[TC4] wrap detectado apos addr %0d", DEPTH - 1);
                $fwrite(file_out, "[TC4] wrap detectado apos addr %0d\n", DEPTH - 1);
                expected_addr = 0;
            end else begin
                expected_addr = expected_addr + 1;
            end

            received_total = received_total + 1;
        end

        @(posedge clk); #1;
        timeout = timeout + 1;
    end

    if (wraps != REPEAT_COUNT) begin
        errors = errors + 1;
        $display("[TC4] ERRO wraps=%0d esperado=%0d", wraps, REPEAT_COUNT);
        $fwrite(file_out, "[TC4] ERRO wraps=%0d esperado=%0d\n", wraps, REPEAT_COUNT);
    end

    if (received_total != expected_total) begin
        errors = errors + 1;
        $display("[TC4] ERRO total=%0d esperado=%0d", received_total, expected_total);
        $fwrite(file_out, "[TC4] ERRO total=%0d esperado=%0d\n", received_total, expected_total);
    end

    if (errors == 0)
        mark_pass(4);
    else
        mark_fail(4, "falha na verificacao de retorno ao endereco zero");
end
endtask

task tc5_done_so_no_final;
    integer expected_total;
    integer received_total;
    integer timeout;
    integer ok;
    integer errors;
begin
    expected_total = DEPTH * REPEAT_COUNT;
    received_total = 0;
    timeout = 0;
    errors = 0;

    $display("\nTC5 - done somente no final");
    $fwrite(file_out, "\nTC5 - done somente no final\n");

    do_reset();
    pulse_prepare();
    wait_ready(5, ok);
    pulse_go();

    while (!done && timeout < (expected_total + 1000)) begin
        @(negedge clk);

        if (done && received_total < expected_total) begin
            errors = errors + 1;
            $display("[TC5] ERRO: done antes do final");
            $fwrite(file_out, "[TC5] ERRO: done antes do final\n");
        end

        if (out_valid)
            received_total = received_total + 1;

        @(posedge clk); #1;
        timeout = timeout + 1;
    end

    if (!done) begin
        errors = errors + 1;
        $display("[TC5] ERRO: done nao ativou");
        $fwrite(file_out, "[TC5] ERRO: done nao ativou\n");
    end

    if (received_total != expected_total) begin
        errors = errors + 1;
        $display("[TC5] ERRO: received=%0d esperado=%0d", received_total, expected_total);
        $fwrite(file_out, "[TC5] ERRO: received=%0d esperado=%0d\n", received_total, expected_total);
    end

    if (errors == 0)
        mark_pass(5);
    else
        mark_fail(5, "done nao respeitou o final");
end
endtask

task tc6_reset_durante_stream;
    integer received_before_reset;
    integer errors;
    integer ok;
begin
    received_before_reset = 0;
    errors = 0;

    $display("\nTC6 - reset durante stream");
    $fwrite(file_out, "\nTC6 - reset durante stream\n");

    do_reset();
    pulse_prepare();
    wait_ready(6, ok);
    pulse_go();

    while (received_before_reset < 20) begin
        @(negedge clk);
        if (out_valid)
            received_before_reset = received_before_reset + 1;
        @(posedge clk); #1;
    end

    rst_n = 0;
    repeat (3) @(posedge clk);
    #1 rst_n = 1;
    repeat (3) @(posedge clk);
    #1;

    if (out_valid) begin
        errors = errors + 1;
        $display("[TC6] ERRO: out_valid ativo apos reset");
        $fwrite(file_out, "[TC6] ERRO: out_valid ativo apos reset\n");
    end

    if (ready_to_stream) begin
        errors = errors + 1;
        $display("[TC6] ERRO: ready_to_stream ativo apos reset");
        $fwrite(file_out, "[TC6] ERRO: ready_to_stream ativo apos reset\n");
    end

    if (done) begin
        errors = errors + 1;
        $display("[TC6] ERRO: done ativo apos reset");
        $fwrite(file_out, "[TC6] ERRO: done ativo apos reset\n");
    end

    if (errors == 0)
        mark_pass(6);
    else
        mark_fail(6, "reset durante stream falhou");
end
endtask

task tc7_reset_durante_ready;
    integer ok;
    integer errors;
begin
    errors = 0;

    $display("\nTC7 - reset durante READY");
    $fwrite(file_out, "\nTC7 - reset durante READY\n");

    do_reset();
    pulse_prepare();
    wait_ready(7, ok);

    rst_n = 0;
    repeat (3) @(posedge clk);
    #1 rst_n = 1;
    repeat (3) @(posedge clk);
    #1;

    if (ready_to_stream) begin
        errors = errors + 1;
        $display("[TC7] ERRO: ready_to_stream continuou ativo apos reset");
        $fwrite(file_out, "[TC7] ERRO: ready_to_stream continuou ativo apos reset\n");
    end

    if (out_valid) begin
        errors = errors + 1;
        $display("[TC7] ERRO: out_valid ativo apos reset");
        $fwrite(file_out, "[TC7] ERRO: out_valid ativo apos reset\n");
    end

    if (done) begin
        errors = errors + 1;
        $display("[TC7] ERRO: done ativo apos reset");
        $fwrite(file_out, "[TC7] ERRO: done ativo apos reset\n");
    end

    if (errors == 0)
        mark_pass(7);
    else
        mark_fail(7, "reset durante READY falhou");
end
endtask

task tc8_reinicia_depois_done;
    integer ok;
    integer received;
    integer errors;
    reg [DATA_BITS-1:0] expected;
begin
    received = 0;
    errors = 0;

    $display("\nTC8 - reinicia depois do done");
    $fwrite(file_out, "\nTC8 - reinicia depois do done\n");

    do_reset();

    pulse_prepare();
    wait_ready(8, ok);
    pulse_go();

    while (!done) begin
        @(posedge clk); #1;
    end

    repeat (5) @(posedge clk);

    pulse_prepare();
    wait_ready(8, ok);
    pulse_go();

    while (received < 16) begin
        @(negedge clk);

        if (out_valid) begin
            expected = ref_mem[received];

            if (out_data !== expected) begin
                errors = errors + 1;
                $display("[TC8] ERRO addr=%0d data=%h esperado=%h",
                         received, out_data, expected);
                $fwrite(file_out, "[TC8] ERRO addr=%0d data=%h esperado=%h\n",
                        received, out_data, expected);
            end

            received = received + 1;
        end

        @(posedge clk); #1;
    end

    if (errors == 0)
        mark_pass(8);
    else
        mark_fail(8, "reinicio depois do done nao voltou ao endereco zero");
end
endtask

initial begin
    pass_count    = 0;
    fail_count    = 0;
    total_errors  = 0;
    cycle_counter = 0;

    file_out = $fopen("saida_memoria.txt", "w");

    if (file_out == 0) begin
        $display("ERRO: nao foi possivel criar saida_memoria.txt");
        $finish;
    end

    $display("============================================================");
    $display(" TESTBENCH COMPLETO - INPUT_BUFFER PREPARE / READY / GO");
    $display("============================================================");

    $fwrite(file_out, "============================================================\n");
    $fwrite(file_out, "TESTBENCH COMPLETO - INPUT_BUFFER PREPARE / READY / GO\n");
    $fwrite(file_out, "============================================================\n");

    tc1_prepare_sem_go();
    tc2_go_sem_prepare();
    tc3_stream_completo();
    tc4_volta_addr_zero();
    tc5_done_so_no_final();
    tc6_reset_durante_stream();
    tc7_reset_durante_ready();
    tc8_reinicia_depois_done();

    $display("\n============================================================");
    $display(" RESULTADO FINAL");
    $display(" PASS TESTS=%0d FAIL TESTS=%0d ERROS INTERNOS=%0d",
             pass_count, fail_count, total_errors);

    if (fail_count == 0 && total_errors == 0)
        $display(">>> TODOS OS TESTES PASSARAM <<<");
    else
        $display(">>> EXISTEM FALHAS <<<");

    $display("============================================================");

    $fwrite(file_out, "\n============================================================\n");
    $fwrite(file_out, "RESULTADO FINAL\n");
    $fwrite(file_out, "PASS TESTS=%0d FAIL TESTS=%0d ERROS INTERNOS=%0d\n",
            pass_count, fail_count, total_errors);

    if (fail_count == 0 && total_errors == 0)
        $fwrite(file_out, "TODOS OS TESTES PASSARAM\n");
    else
        $fwrite(file_out, "EXISTEM FALHAS\n");

    $fwrite(file_out, "============================================================\n");

    $fclose(file_out);

    $finish;
end

endmodule