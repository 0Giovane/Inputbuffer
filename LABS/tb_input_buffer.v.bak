`timescale 1ns/1ps

module tb_input_buffer;

parameter CLK_PERIOD = 10;
parameter DEPTH      = 16384;
parameter ADDR_BITS  = 14;
parameter DATA_BITS  = 64;

reg                   clk;
reg                   rst_n;
reg                   start;
reg  [ADDR_BITS:0]    num_words;
reg                   out_ready;

wire [DATA_BITS-1:0]  out_data;
wire                  out_valid;
wire                  done;
wire                  error;
wire [2:0]            state_dbg;

reg [DATA_BITS-1:0] ref_mem [0:DEPTH-1];

integer pass_count;
integer fail_count;

Input_Buffer #(
    .DEPTH     (DEPTH),
    .ADDR_BITS (ADDR_BITS),
    .DATA_BITS (DATA_BITS)
) dut (
    .clk       (clk),
    .rst_n     (rst_n),
    .start     (start),
    .num_words (num_words),
    .out_ready (out_ready),
    .out_data  (out_data),
    .out_valid (out_valid),
    .done      (done),
    .error     (error),
    .state_dbg (state_dbg)
);

initial clk = 0;
always #(CLK_PERIOD/2) clk = ~clk;

initial begin
    integer k;

    for (k = 0; k < DEPTH; k = k + 1)
        ref_mem[k] = 64'h0000000000000000;

    ref_mem[0]  = 64'hABCDEF0123456789;
    ref_mem[1]  = 64'h0123456789ABCDEF;
    ref_mem[2]  = 64'hFEDCBA9876543210;
    ref_mem[3]  = 64'h1122334455667788;
    ref_mem[4]  = 64'h8877665544332211;
    ref_mem[5]  = 64'hAABBCCDDEEFF0011;
    ref_mem[6]  = 64'h1100FFEEDDCCBBAA;
    ref_mem[7]  = 64'hDEADBEEFCAFEBABE;
    ref_mem[8]  = 64'hCAFEBABDEADBEEF0;
    ref_mem[9]  = 64'h0F0F0F0F0F0F0F0F;
    ref_mem[10] = 64'hF0F0F0F0F0F0F0F0;
    ref_mem[11] = 64'hAAAAAAAAAAAAAAAA;
    ref_mem[12] = 64'h5555555555555555;
    ref_mem[13] = 64'hFFFFFFFFFFFFFFFF;
    ref_mem[14] = 64'h0000000000000001;
    ref_mem[15] = 64'h8000000000000000;
end

task do_reset;
begin
    rst_n     = 0;
    start     = 0;
    num_words = 0;
    out_ready = 0;

    repeat (5) @(posedge clk);
    #1;
    rst_n = 1;

    repeat (2) @(posedge clk);
    #1;
end
endtask

task run_and_check;
    input [ADDR_BITS:0] n_words;
    input integer       tc_num;
    input               backpressure;

    integer i;
    integer timeout;
    integer cycle_count;
    reg [DATA_BITS-1:0] expected;

begin
    i           = 0;
    timeout     = 0;
    cycle_count = 0;

    @(posedge clk); #1;
    num_words = n_words;
    start     = 1;
    out_ready = 1;

    @(posedge clk); #1;
    start = 0;

    while (i < n_words) begin

        if (backpressure) begin
            if (cycle_count % 4 == 0)
                out_ready = 0;
            else
                out_ready = 1;
        end else begin
            out_ready = 1;
        end

        @(posedge clk); #1;

        if (out_valid && out_ready) begin
            expected = ref_mem[i];

            if (out_data === expected) begin
                $display("[TC%0d] Palavra %0d: PASS  out=%h  esperado=%h",
                         tc_num, i, out_data, expected);
                pass_count = pass_count + 1;
            end else begin
                $display("[TC%0d] Palavra %0d: FAIL  out=%h  esperado=%h",
                         tc_num, i, out_data, expected);
                fail_count = fail_count + 1;
            end

            i = i + 1;
        end

        timeout     = timeout + 1;
        cycle_count = cycle_count + 1;

        if (timeout > (n_words * 80 + 300)) begin
            $display("[TC%0d] TIMEOUT durante transmissao", tc_num);
            fail_count = fail_count + 1;
            disable run_and_check;
        end
    end

    timeout   = 0;
    out_ready = 1;

    while (!done) begin
        @(posedge clk); #1;
        timeout = timeout + 1;

        if (timeout > 30) begin
            $display("[TC%0d] FAIL - done nunca pulsou", tc_num);
            fail_count = fail_count + 1;
            disable run_and_check;
        end
    end

    $display("[TC%0d] done OK", tc_num);

    out_ready = 0;
    repeat (5) @(posedge clk);
end
endtask

task test_error;
    input [ADDR_BITS:0] value;
    input integer       tc_num;

    integer timeout;

begin
    timeout = 0;

    @(posedge clk); #1;
    num_words = value;
    start     = 1;

    @(posedge clk); #1;
    start = 0;

    while (!error && timeout < 20) begin
        @(posedge clk); #1;
        timeout = timeout + 1;
    end

    if (error) begin
        $display("[TC%0d] ERROR PASS", tc_num);
        pass_count = pass_count + 1;
    end else begin
        $display("[TC%0d] ERROR FAIL", tc_num);
        fail_count = fail_count + 1;
    end

    repeat (5) @(posedge clk);
end
endtask

task reset_mid_transmission;
begin
    @(posedge clk); #1;
    num_words = 16;
    start     = 1;
    out_ready = 1;

    @(posedge clk); #1;
    start = 0;

    repeat (8) @(posedge clk);

    rst_n = 0;
    @(posedge clk); #1;
    rst_n = 1;

    @(posedge clk); #1;

    if (!out_valid && !done && !error) begin
        $display("[TC6] Reset PASS");
        pass_count = pass_count + 1;
    end else begin
        $display("[TC6] Reset FAIL  out_valid=%b done=%b error=%b",
                 out_valid, done, error);
        fail_count = fail_count + 1;
    end
end
endtask

initial begin
    pass_count = 0;
    fail_count = 0;

    $display("============================================================");
    $display(" TESTBENCH INPUT BUFFER - ENGG57 UFBA");
    $display("============================================================");

    $display("\n------------------------------------------------------------");
    $display("TC1 - TRANSMISSAO BASICA DE 16 PALAVRAS");
    $display("Objetivo:");
    $display("- Verificar se o modulo inicia corretamente apos start");
    $display("- Ler os 16 primeiros enderecos da ROM");
    $display("- Comparar cada saida out_data com o valor esperado");
    $display("- Confirmar que out_valid ativa durante a transmissao");
    $display("- Confirmar que done pulsa ao final");
    $display("- Condicao: out_ready sempre ativo");
    $display("------------------------------------------------------------");
    do_reset();
    run_and_check(16, 1, 0);

    $display("\n------------------------------------------------------------");
    $display("TC2 - TRANSMISSAO ESTENDIDA DE 32 PALAVRAS");
    $display("Objetivo:");
    $display("- Verificar incremento continuo dos enderecos da ROM");
    $display("- Testar leitura alem das 16 primeiras palavras");
    $display("- Confirmar que a regiao nao inicializada retorna zero esperado");
    $display("- Confirmar que done pulsa somente apos a ultima palavra");
    $display("- Condicao: out_ready sempre ativo");
    $display("------------------------------------------------------------");
    do_reset();
    run_and_check(32, 2, 0);

    $display("\n------------------------------------------------------------");
    $display("TC3 - BACK-PRESSURE COM READY CONTROLADO");
    $display("Objetivo:");
    $display("- Simular um receptor que nem sempre esta pronto");
    $display("- Forcar pequenas pausas no sinal out_ready");
    $display("- Validar o protocolo ready/valid");
    $display("- Garantir que o dado seja mantido quando ready = 0");
    $display("- Garantir que a FSM continue corretamente apos pausas");
    $display("------------------------------------------------------------");
    do_reset();
    run_and_check(16, 3, 1);

    $display("\n------------------------------------------------------------");
    $display("TC4 - ENTRADA INVALIDA: NUM_WORDS = 0");
    $display("Objetivo:");
    $display("- Testar comando invalido com zero palavras");
    $display("- Garantir que nenhuma leitura da ROM seja iniciada");
    $display("- Confirmar que o sinal error seja ativado");
    $display("- Confirmar protecao contra transmissao vazia");
    $display("------------------------------------------------------------");
    do_reset();
    test_error(0, 4);

    $display("\n------------------------------------------------------------");
    $display("TC5 - ENTRADA INVALIDA: NUM_WORDS > DEPTH");
    $display("Objetivo:");
    $display("- Testar tentativa de ler mais palavras que a profundidade da ROM");
    $display("- Evitar acesso fora do limite de enderecos");
    $display("- Confirmar que o sinal error seja ativado");
    $display("- Confirmar protecao contra overflow de endereco");
    $display("------------------------------------------------------------");
    do_reset();
    test_error(DEPTH + 1, 5);

    $display("\n------------------------------------------------------------");
    $display("TC6 - RESET DURANTE A TRANSMISSAO");
    $display("Objetivo:");
    $display("- Iniciar uma transmissao normal");
    $display("- Aplicar reset no meio do envio");
    $display("- Verificar se a FSM retorna para condicao segura");
    $display("- Confirmar limpeza de out_valid, done e error");
    $display("- Validar robustez do modulo em reset assincrono");
    $display("------------------------------------------------------------");
    do_reset();
    reset_mid_transmission();

    $display("\n============================================================");
    $display(" RESULTADO FINAL");
    $display(" PASS: %0d | FAIL: %0d | TOTAL: %0d",
             pass_count, fail_count, pass_count + fail_count);

    if (fail_count == 0)
        $display(" >>> TODOS OS TESTES PASSARAM <<<");
    else
        $display(" >>> ATENCAO: %0d TESTE(S) FALHARAM <<<", fail_count);

    $display("============================================================");

    $finish;
end

endmodule