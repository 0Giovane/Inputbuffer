-- Arquivo MIF para ROM do Input Buffer
-- Configuração: 16384 palavras x 64 bits
-- Placa: DE2-115 / Cyclone IV EP4CE115F29C7
-- Uso: Carregar a chave reconciliada para o módulo Privacy Amplification

DEPTH = 16384;       -- Número de palavras
WIDTH = 64;          -- Largura de cada palavra em bits

ADDRESS_RADIX = HEX; -- Endereços em hexadecimal
DATA_RADIX = HEX;    -- Dados em hexadecimal

CONTENT BEGIN
    -- Exemplo: os primeiros 16 endereços com dados de teste
    -- Substitua pelo conteúdo real da chave reconciliada
    0000 : ABCDEF0123456789;
    0001 : 0123456789ABCDEF;
    0002 : FEDCBA9876543210;
    0003 : 1122334455667788;
    0004 : 8877665544332211;
    0005 : AABBCCDDEEFF0011;
    0006 : 1100FFEEDDCCBBAA;
    0007 : DEADBEEFCAFEBABE;
    0008 : CAFEBABDEADBEEF0;
    0009 : 0F0F0F0F0F0F0F0F;
    000A : F0F0F0F0F0F0F0F0;
    000B : AAAAAAAAAAAAAAAA;
    000C : 5555555555555555;
    000D : FFFFFFFFFFFFFFFF;
    000E : 0000000000000001;
    000F : 8000000000000000;

    -- Preenche o restante com zeros
    [0010..3FFF] : 0000000000000000;
END;
