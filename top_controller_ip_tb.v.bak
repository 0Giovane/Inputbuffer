// ============================================================
//  4.  Testbench — top_controller (versão IP)
//      Valida escrita na RAM, leitura → FIFO → drain
//      A latência extra do READ_WAIT é transparente aqui
//      pois o testbench aguarda ram_ready normalmente.
// ============================================================
`timescale 1ns/1ps

module top_controller_ip_tb;

    localparam BUF_DEPTH = 4;
    localparam OUT_WIDTH = 8;

    reg        clk, rst_n;
    reg [13:0] addr_in;
    reg [63:0] din_in;
    reg        req_read, req_write;

    wire [OUT_WIDTH-1:0] data_out;
    wire data_valid, fifo_full, fifo_empty, ram_ready;

    top_controller #(
        .BUF_DEPTH(BUF_DEPTH),
        .OUT_WIDTH(OUT_WIDTH)
    ) dut (
        .clk       (clk),
        .rst_n     (rst_n),
        .addr_in   (addr_in),
        .din_in    (din_in),
        .req_read  (req_read),
        .req_write (req_write),
        .data_out  (data_out),
        .data_valid(data_valid),
        .fifo_full (fifo_full),
        .fifo_empty(fifo_empty),
        .ram_ready (ram_ready)
    );

    initial clk = 0;
    always #10 clk = ~clk;

    task pulse_write(input [13:0] a, input [63:0] d);
        begin
            addr_in = a; din_in = d;
            req_write = 1; req_read = 0;
            @(posedge clk); req_write = 0;
            wait(ram_ready); @(posedge clk);
        end
    endtask

    task pulse_read(input [13:0] a);
        begin
            addr_in = a; din_in = 0;
            req_read = 1; req_write = 0;
            @(posedge clk); req_read = 0;
            wait(ram_ready); @(posedge clk);
        end
    endtask

    integer i;
    initial begin
        rst_n = 0; req_read = 0; req_write = 0;
        addr_in = 0; din_in = 0;
        repeat(4) @(posedge clk);
        rst_n = 1; @(posedge clk);

        $display("==> WRITE 0xDEADBEEFCAFE0011 -> addr 0x0010");
        pulse_write(14'h0010, 64'hDEADBEEFCAFE0011);

        $display("==> READ addr 0x0010 -> FIFO");
        pulse_read(14'h0010);

        $display("==> Aguardando drain...");
        repeat(30) begin
            @(posedge clk);
            if (data_valid)
                $display("    [%0t ns] data_out = 0x%h", $time, data_out);
        end

        $display("==> Concluido.");
        $finish;
    end

    initial begin
        $dumpfile("top_controller_ip_tb.vcd");
        $dumpvars(0, top_controller_ip_tb);
    end

endmodule