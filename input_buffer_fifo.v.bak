// ============================================================
//  2.  Input Buffer FIFO — sem alterações funcionais
//
//  A interface e o comportamento são idênticos à versão
//  anterior. O módulo é independente do tipo de RAM.
//  Reproduzido aqui para manter o arquivo autocontido.
// ============================================================
module input_buffer_fifo #(
    parameter IN_WIDTH  = 64,
    parameter BUF_DEPTH = 16,
    parameter OUT_WIDTH = 8
)(
    input  wire                 clk,
    input  wire                 rst_n,
    input  wire [IN_WIDTH-1:0]  push_data,
    input  wire                 wr_en,
    output reg  [OUT_WIDTH-1:0] data_out,
    output reg                  data_valid,
    input  wire                 rd_en,
    output wire                 full,
    output wire                 empty
);

    initial begin
        if (OUT_WIDTH > IN_WIDTH) begin
            $display("ERRO: OUT_WIDTH (%0d) > IN_WIDTH (%0d)", OUT_WIDTH, IN_WIDTH);
            $finish;
        end
    end

    localparam PTR_W = $clog2(BUF_DEPTH);

    reg [IN_WIDTH-1:0] fifo_mem [0:BUF_DEPTH-1];
    reg [PTR_W:0]      wr_ptr, rd_ptr;

    assign full  = (wr_ptr[PTR_W] != rd_ptr[PTR_W]) &&
                   (wr_ptr[PTR_W-1:0] == rd_ptr[PTR_W-1:0]);
    assign empty = (wr_ptr == rd_ptr);

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) wr_ptr <= 0;
        else if (wr_en && !full) begin
            fifo_mem[wr_ptr[PTR_W-1:0]] <= push_data;
            wr_ptr <= wr_ptr + 1'b1;
        end
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            rd_ptr     <= 0;
            data_out   <= {OUT_WIDTH{1'b0}};
            data_valid <= 1'b0;
        end else if (rd_en && !empty) begin
            data_out   <= fifo_mem[rd_ptr[PTR_W-1:0]][OUT_WIDTH-1:0];
            data_valid <= 1'b1;
            rd_ptr     <= rd_ptr + 1'b1;
        end else begin
            data_valid <= 1'b0;
        end
    end

endmodule